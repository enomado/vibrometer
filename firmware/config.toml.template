# Параметры сборки прошивки. Скопировать в `config.toml` и заполнить своими
# значениями — `config.toml` в .gitignore, чтобы креды не уезжали в репозиторий.
#
#   cp config.toml.template config.toml
#
# build.rs читает этот файл и генерирует из него константы (см. OUT_DIR/constants.rs),
# так что после правки конфига крейт пересобирается автоматически.
[firmware]
# Сеть, к которой подключается ESP32-C3.
wifi_ssid = "my-network"
wifi_passwd = "my-password"

# Адрес хоста с приложением-приёмником: прошивка сама открывает TCP-соединение.
# `./update-ip.sh` проставляет сюда текущий IP этой машины (актуально при DHCP).
server_ip = "192.168.1.100"
server_port = 7100
